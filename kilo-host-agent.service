[Unit]
Description=Kilo-Style AI Coding & 24/7 Bot Hosting Telegram Agent
Documentation=file:///opt/kilo-host-agent/README.md
After=network-online.target
Wants=network-online.target
# Never stop trying to restart — this is a 24/7 service.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/kilo-host-agent
EnvironmentFile=/opt/kilo-host-agent/.env
Environment=PYTHONUNBUFFERED=1
Environment=PORT=10000
ExecStart=/opt/kilo-host-agent/.venv/bin/python /opt/kilo-host-agent/main.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
