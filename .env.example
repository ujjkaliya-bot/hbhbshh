# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:PASTE_YOUR_BOTFATHER_TOKEN_HERE
ADMIN_USER_ID=123456789

# ---- AI (any OpenAI-compatible endpoint: OpenAI / OpenRouter / Kilo / Gemini) ----
AI_API_KEY=PASTE_YOUR_AI_KEY_HERE
AI_BASE_URL=https://api.kilo.ai/api/openrouter/v1
# Kilo (default): https://api.kilo.ai/api/openrouter/v1 + kilo-auto/free
#   NOTE: kilocode.ai redirects to kilo.ai and does NOT serve the API — use
#   the api.kilo.ai/api/openrouter/v1 base above.
# OpenRouter example:  AI_BASE_URL=https://openrouter.ai/api/v1
# OpenAI example:      AI_BASE_URL=https://api.openai.com/v1
# Google Gemini (OpenAI-compatible): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Gemini keys start with "AQ." and only work against the Gemini base URL above.
AI_MODEL=kilo-auto/free
# Recommended models: kilo-auto/free (Kilo, free), gpt-4o-mini (OpenAI),
#   gemini-3.5-flash (Gemini).



# ---- Cluster tuning ----
WATCHDOG_INTERVAL=60
# KILO_HOST_AGENT_DB=./platform.db
# CLUSTER_KEY_PATH=/root/.ssh/cluster_key

# ---- Render / 24/7 keep-alive ----
# PORT is set automatically by Render (default 10000 here). GET / returns 200.
# PORT=10000
# Paste the cluster ED25519 PRIVATE key (raw or base64) so the bot can SSH into
# your Selfhost servers from Render's ephemeral filesystem. Written to
# CLUSTER_KEY_PATH (or /tmp/cluster_key on Render) with chmod 600.
# CLUSTER_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----...
# CLUSTER_PRIVATE_KEY_B64=LS0tLS1CRUdJTiBPUEVOU1NI...
